{
  "name": "chaoxing-sign",
  "version": "4.3.5",
  "description": "超星学习通签到项目",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev:serve dev --filter=./apps/*",
    "build": "pnpm --filter=./apps/server build && pnpm --filter=./apps/web build",
    "preview": "pnpm --filter=./apps/web preview",
    "serve": "node ./apps/server/build/serve.js",
    "lint": "turbo run lint"
  },
  "repository": "https://github.com/cxOrz/chaoxing-sign-cli.git",
  "author": "mcx",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.9",
  "devDependencies": {
    "ts-node": "^10.9.1",
    "turbo": "^1.8.8"
  }
}
